# Enterprise Knowledge Assistant - Root Environment Configuration Example
# Copy this file to backend/.env and configure your variables

# Application
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Supports local MongoDB, Docker MongoDB, or MongoDB Atlas connection strings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=knowledge_assistant

# Storage Configuration
CHROMA_PERSIST_DIRECTORY=storage/chroma_db
DOCUMENTS_STORAGE_DIRECTORY=storage/documents

# GenAI Model Configuration
# Provider options: "gemini" | "openai" | "groq" | "mock"
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-2.5-flash

# API Credentials (Server-side only)
# For Gemini:
GEMINI_API_KEY=your_gemini_api_key_here

# For OpenAI (if AI_PROVIDER=openai):
OPENAI_API_KEY=your_openai_api_key_here

# For Groq (if AI_PROVIDER=groq):
GROQ_API_KEY=your_groq_api_key_here

# Auth Secret Key for JWT Tokens
JWT_SECRET_KEY=enterprise_knowledge_assistant_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
